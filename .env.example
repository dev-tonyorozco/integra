DEBUG=0
SECRET_KEY=replace-with-a-random-secret-before-starting
ALLOWED_HOSTS=localhost,127.0.0.1,integra.example.com
SITE_URL=https://integra.example.com
CSRF_TRUSTED_ORIGINS=https://integra.example.com
